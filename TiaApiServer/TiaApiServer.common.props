<?xml version="1.0" encoding="utf-8"?>
<!--
  버전별 csproj 3개가 공유하는 설정.

  Program.cs 는 한 벌뿐이다. V19/V20/V21 은 Openness 의 네임스페이스와 타입
  이름을 전부 보존하므로 도메인 코드는 그대로 컴파일된다 — 버전마다 달라지는
  건 <Reference> 목록과 DefineConstants 의 TIA_Vxx 뿐이다.

  V21 은 단일 Siemens.Engineering.dll 이 기능별로 쪼개졌지만 네임스페이스는
  Siemens.Engineering.* 그대로다(실측 확인). Program.cs 가 쓰는 네임스페이스의
  V21 소속:
    Base          Siemens.Engineering · .Multiuser · .Compiler · .Library(.*) · .HW(.Features)
    Step7         .SW(.Blocks/.Tags/.Types/.Units/.ExternalSources/.TechnologicalObjects) · .Cax · .HW
    WinCC         .Hmi(.Communication/.Screen/.Tag/.TextGraphicList)
    WinCCUnified  .HmiUnified(.HmiConnections/.UI.Screens/.UI.ScreenGroup)
    Startdrive    .MC.Drives(.DFI)
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>TiaApiServer</RootNamespace>
    <StartupObject>TiaApiServer.Entry</StartupObject>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- Openness 는 x64 전용이다. AnyCPU 로 두면 32비트로 떠서 로드에 실패한다. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 세 산출물이 한 폴더에 모이게 한다. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;$(TiaDefine)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <DefineConstants>TRACE;$(TiaDefine)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
